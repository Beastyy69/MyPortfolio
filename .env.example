# Copy to .env (local) or add in Render → Environment. All optional.

# Live domain, no trailing slash — fills canonical/Open Graph URLs, robots.txt and sitemap.xml
VITE_SITE_URL=https://harshitshaw.in

# EmailJS (branded emails via your Gmail). Without these the form uses FormSubmit.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
